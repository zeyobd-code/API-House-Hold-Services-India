# Application Environment & Server Config
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://api.rajseba.com
FRONTEND_URL=https://rajseba.in

# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database_name
DATABASE_SSL=true

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Google OAuth Credentials
CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here

# Admin Configuration
SUPERADMIN_PHONE=01700000000

# AI API Keys (OpenRouter / Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# SMS Gateway Configuration (mram.com.bd)
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=your_sms_sender_id_here

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Payment Gateway Configuration (SSLCommerz)
SSL_COMMERZ_STORE_ID=your_store_id
SSL_COMMERZ_STORE_PASSWORD=your_store_password
